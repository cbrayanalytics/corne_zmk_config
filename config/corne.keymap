#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DVORAK    0
#define QWERTY    1
#define LOWER     2
#define RAISE     3
#define COLEMAK   4
#define COLEMAKDH 5
#define ADJUST    6

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <175>;
};

/ {
        behaviors {
                // Positional home-row mods: a mod only engages when the next key
                // is on the OPPOSITE hand, so same-hand rolls can never misfire.
                // Positions are 0-indexed in keymap binding order:
                //   left  hand = 0-4, 10-14, 20-24, 30-32
                //   right hand = 5-9, 15-19, 25-29, 33-35
                // The home-row mods sit at 10-13 (left) and 16-19 (right) in all
                // four layout layers, so one pair of behaviors covers them all.

                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        bindings = <&kp>, <&kp>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
                        hold-trigger-on-release;
                };

                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        bindings = <&kp>, <&kp>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
                        hold-trigger-on-release;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                dvorak_layer {
                        display-name = "Dvorak";
// -----------------------------------------------------------------------------------------
// |   '   |     ,     |     .     |     P     |   Y   |   |   F   |     G     |     C     |     R     |     L     |
// | mt(LGUI)A | mt(LALT)O | mt(LCTL)E | mt(LSFT)U |   I   |   |   D   | mt(RSFT)H | mt(RCTL)T | mt(RALT)N | mt(RGUI)S |
// |   ;   |     Q     |     J     |     K     |   X   |   |   B   |     M     |     W     |     V     |     Z     |
//                     | ESC | mo LOWER | TAB |   | ENT | lt RAISE SPC | lt ADJUST BSPC |
                        bindings = <
   &kp SQT        &kp COMMA      &kp DOT        &kp P          &kp Y        &kp F      &kp G          &kp C          &kp R        &kp L
   &hml LGUI A     &hml LALT O     &hml LCTRL E    &hml LSHIFT U   &kp I        &kp D      &hmr RSHIFT H   &hmr RCTRL T    &hmr RALT N   &hmr RGUI S
   &kp SEMI       &kp Q          &kp J          &kp K          &kp X        &kp B      &kp M          &kp W          &kp V        &kp Z
                                 &kp ESC        &mo LOWER      &kp TAB      &kp ENTER  &lt RAISE SPACE    &lt ADJUST BSPC
                        >;
                };

                qwerty_layer {
                        display-name = "QWERTY";
// -----------------------------------------------------------------------------------------
// |  Q  |    W    |    E    |    R    |  T  |   |  Y  |    U    |    I    |    O    |    P    |
// | mt(LGUI)A | mt(LALT)S | mt(LCTL)D | mt(LSFT)F |  G  |   |  H  | mt(RSFT)J | mt(RCTL)K | mt(RALT)L | mt(RGUI); |
// |  Z  |    X    |    C    |    V    |  B  |   |  N  |    M    |    ,    |    .    |    /    |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &kp Q        &kp W        &kp E          &kp R          &kp T        &kp Y      &kp U          &kp I          &kp O        &kp P
   &hml LGUI A   &hml LALT S   &hml LCTRL D    &hml LSHIFT F   &kp G        &kp H      &hmr RSHIFT J   &hmr RCTRL K    &hmr RALT L   &hmr RGUI SEMI
   &kp Z        &kp X        &kp C          &kp V          &kp B        &kp N      &kp M          &kp COMMA      &kp DOT      &kp FSLH
                             &trans         &trans         &trans       &trans     &trans         &trans
                        >;
                };

                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |  `  |  [  |  {  |  \  |  -  |   |  =  |  /  |  }  |  ]  |  '  |
// | LGUI| LALT| LCTL| LSFT| DEL |   | LEFT| DOWN|  UP | RGT |RSFT |
// |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &kp GRAVE   &kp LBKT   &kp LBRC   &kp BSLH    &kp MINUS       &kp EQUAL   &kp FSLH   &kp RBRC   &kp RBKT   &kp SQT
   &kp LGUI    &kp LALT   &kp LCTRL  &kp LSHIFT  &kp DEL         &kp LEFT    &kp DOWN   &kp UP     &kp RIGHT  &kp RSHIFT
   &kp F1      &kp F2     &kp F3     &kp F4      &kp F5          &kp F6      &kp F7     &kp F8     &kp F9     &kp F10
                          &trans     &trans      &trans           &trans      &trans     &trans
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
// | LGUI| LALT| LCTL| LSFT|     |   |     | RSFT| RCTL| RALT| RGUI|
// |CAPSW| HOME|PG_UP|PG_DN| END |   |     |     |     |     |     |
//             |     |     |     |   | ENT |     |     |
                        bindings = <
   &kp N1    &kp N2     &kp N3     &kp N4      &kp N5          &kp N6     &kp N7     &kp N8    &kp N9     &kp N0
   &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHIFT  &trans          &trans     &kp RSHIFT &kp RCTRL &kp RALT   &kp RGUI
   &caps_word &kp HOME  &kp PG_UP  &kp PG_DN   &kp END         &trans     &trans     &trans    &trans     &trans
                        &trans     &trans      &trans           &kp ENTER  &trans     &trans
                        >;
                };

                colemak_layer {
                        display-name = "Colemak";
// -----------------------------------------------------------------------------------------
// |  Q  |    W    |    F    |    P    |  G  |   |  J  |    L    |    U    |    Y    |    ;    |
// | mt(LGUI)A | mt(LALT)R | mt(LCTL)S | mt(LSFT)T |  D  |   |  H  | mt(RSFT)N | mt(RCTL)E | mt(RALT)I | mt(RGUI)O |
// |  Z  |    X    |    C    |    V    |  B  |   |  K  |    M    |    ,    |    .    |    /    |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &kp Q          &kp W          &kp F          &kp P          &kp G        &kp J      &kp L          &kp U          &kp Y        &kp SEMI
   &hml LGUI A     &hml LALT R     &hml LCTRL S    &hml LSHIFT T   &kp D        &kp H      &hmr RSHIFT N   &hmr RCTRL E    &hmr RALT I   &hmr RGUI O
   &kp Z          &kp X          &kp C          &kp V          &kp B        &kp K      &kp M          &kp COMMA      &kp DOT      &kp FSLH
                                 &trans         &trans         &trans       &trans     &trans         &trans
                        >;
                };

                colemakdh_layer {
                        display-name = "ColemakDH";
// -----------------------------------------------------------------------------------------
// |  Q  |    W    |    F    |    P    |  B  |   |  J  |    L    |    U    |    Y    |    ;    |
// | mt(LGUI)A | mt(LALT)R | mt(LCTL)S | mt(LSFT)T |  G  |   |  M  | mt(RSFT)N | mt(RCTL)E | mt(RALT)I | mt(RGUI)O |
// |  Z  |    X    |    C    |    D    |  V  |   |  K  |    H    |    ,    |    .    |    /    |
//             |     |     |     |   |     |     |     |
                        bindings = <
   &kp Q          &kp W          &kp F          &kp P          &kp B        &kp J      &kp L          &kp U          &kp Y        &kp SEMI
   &hml LGUI A     &hml LALT R     &hml LCTRL S    &hml LSHIFT T   &kp G        &kp M      &hmr RSHIFT N   &hmr RCTRL E    &hmr RALT I   &hmr RGUI O
   &kp Z          &kp X          &kp C          &kp D          &kp V        &kp K      &kp H          &kp COMMA      &kp DOT      &kp FSLH
                                 &trans         &trans         &trans       &trans     &trans         &trans
                        >;
                };

                adjust_layer {
                        display-name = "Adjust";
// -----------------------------------------------------------------------------------------
// |  CMK  |  CDH  | BT SEL3 | BT SEL4 |         |   |         |         |         |         |         |
// | QWERTY| BT SEL2| BT SEL1| BT SEL0 | BT CLR  |   |  C_PP   | VOL UP  | VOL DN  | C_NEXT  | C_PREV  |
// |  BOOT |  RESET |         |         | SOFT_OFF|   |         |         |         |  RESET  |  BOOT   |
//                     |         |         |         |   |         |         |         |
                        bindings = <
   &tog COLEMAK      &tog COLEMAKDH    &bt BT_SEL 3      &bt BT_SEL 4      &none                 &none             &none             &none             &none             &none
   &tog QWERTY       &bt BT_SEL 2      &bt BT_SEL 1      &bt BT_SEL 0      &bt BT_CLR            &kp C_PP          &kp C_VOL_UP      &kp C_VOL_DN      &kp C_NEXT        &kp C_PREV
   &bootloader       &sys_reset        &none             &none             &soft_off             &none             &none             &none             &sys_reset        &bootloader
                                       &trans            &trans            &trans                &trans            &trans            &trans
                        >;
                };

        };
};
